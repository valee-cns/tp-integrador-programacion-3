<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel administrativo | LV - Loot Valley</title>
    <link rel="stylesheet" href="/css/productos.css">
    <link rel="stylesheet" href="/css/tema.css">
    <script src="/js/tema.js"></script>
    <link rel="icon" href="/img/logo-loot-valley.png" type="image/png">
</head>
<body class="pagina-catalogo pagina-panel">
    <header class="cabecera-bienvenida">
        <div class="marca-bienvenida">
            <img src="/img/logo-loot-valley.png" alt="" width="80" height="80">
            <div class="texto-marca-bienvenida">
                <h1>LV - Loot Valley</h1>
                <p>Valentina Cisneros y Lian Giaccone — Programación III</p>
            </div>
        </div>

        <nav class="acciones-bienvenida">
            <a class="boton-enlace" href="/">Ir al autoservicio</a>
            <button type="button" id="cambiar-tema">Cambiar tema</button>
            <button type="button" id="cerrar-sesion">Cerrar sesión</button>
        </nav>
    </header>

    <main class="contenido-catalogo">
        <h2>Panel administrativo</h2>
        <a class="boton-enlace" href="/admin/productos/nuevo">Nuevo producto</a>
        <p>Administrador: <%= administrador.correo %></p>
        <p id="mensaje-panel" role="alert"></p>

        <div class="filtros-catalogo">
            <div class="filtro-categoria">
                <label for="categoria-panel">Categoría:</label>
                <select id="categoria-panel">
                    <option value="">Todas</option>
                    <% for (const categoria of categorias) { %>
                        <option value="<%= categoria.id %>"><%= categoria.nombre %></option>
                    <% } %>
                </select>
            </div>

            <div class="filtros-panel">
                <label for="buscar-producto">Nombre del producto:</label>
                <input id="buscar-producto" type="search" placeholder="Buscar producto...">
            </div>
        </div>

        <p id="resultado-filtros-panel" role="status"></p>

        <% for (const categoria of categorias) { %>
            <section data-categoria-id="<%= categoria.id %>">
                <h2><%= categoria.nombre %></h2>

                <% const productosCategoria = productos.filter(
                    (producto) => producto.categoriaId === categoria.id
                ); %>

                <% if (productosCategoria.length === 0) { %>
                    <p>No hay productos en esta categoría.</p>
                <% } %>
                <div class="grilla-panel">
                    <% for (const producto of productosCategoria) { %>
                        <article class="producto">
                            <div class="imagen-producto">
                                <% if (producto.imagen && producto.imagen !== "/img/producto-pendiente.png") { %>
                                    <img src="<%= producto.imagen %>"
                                        alt="Imagen de <%= producto.nombre %>">
                                <% } else { %>
                                    <span>Sin imagen cargada</span>
                                <% } %>
                            </div>
                            <h3 class="nombre-producto"><%= producto.nombre %></h3>
                            <p><%= producto.descripcion %></p>

                            <p>
                                Precio:
                                <strong>
                                    <%= Number(producto.precio).toLocaleString(
                                    "es-AR",
                                    { style: "currency", currency: "ARS" }) %>
                                </strong>
                            </p>

                            <p>
                                Estado:
                                <strong><%= producto.activo ? "Activo" : "Inactivo" %> </strong>
                            </p>
                            <div class="acciones-producto-panel">
                                <button
                                    type="button"
                                    class="cambiar-estado"
                                    data-id="<%= producto.id %>"
                                    data-activo="<%= producto.activo ? 'false' : 'true' %>"
                                >
                                    <%= producto.activo ? "Desactivar" : "Reactivar" %>
                                </button>
                                <a class="boton-enlace" href="/admin/productos/<%= producto.id %>/editar">Editar</a>
                            </div>
                        </article>
                    <% } %>
                </div>
            </section>
        <% } %>
    </main>

    <dialog id="confirmar-estado" aria-labelledby="titulo-confirmar-estado">
        <h2 id="titulo-confirmar-estado">Cambiar el estado del producto</h2>
        <p id="pregunta-estado"></p>

        <form method="dialog">
            <button type="submit" value="cancelar">Cancelar</button>
            <button type="submit" value="confirmar">Confirmar</button>
        </form>
    </dialog>

    <script src="/js/admin.js"></script>
</body>
</html>