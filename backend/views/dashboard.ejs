<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel administrativo | LV - Loot Valley</title>
    <link rel="stylesheet" href="/css/productos.css">
    <link rel="stylesheet" href="/css/tema.css">
    <script src="/js/tema.js"></script>
</head>
<body>
    <header>
        <h1>LV - Loot Valley</h1>
        <p>Trabajo de Valen y Lian — Programación III</p>

        <nav>
            <a href="/">Ir al autoservicio</a>
            <button type="button" id="cambiar-tema">Cambiar tema</button>
            <button id="cerrar-sesion" type="button">Cerrar sesión</button>
        </nav>
    </header>

    <main>
        <h2>Panel administrativo</h2>
        <a href="/admin/productos/nuevo">Nuevo producto</a>
        <p>Administrador: <%= administrador.correo %></p>
        <p id="mensaje-panel" role="alert"></p>

        <% for (const categoria of categorias) { %>
            <section>
                <h2><%= categoria.nombre %></h2>

                <% const productosCategoria = productos.filter(
                    (producto) => producto.categoriaId === categoria.id
                ); %>

                <% if (productosCategoria.length === 0) { %>
                    <p>No hay productos en esta categoría.</p>
                <% } %>

                <% for (const producto of productosCategoria) { %>
                    <article class="producto">
                        <div class="imagen-producto">
                            <% if (producto.imagen && producto.imagen !== "/img/producto-pendiente.png") { %>
                                <img src="<%= producto.imagen %>"
                                    alt="Imagen de <%= producto.nombre %>">
                            <% } else { %>
                                <span>Sin imagen cargada</span>
                            <% } %>
                        </div>
                        <h3><%= producto.nombre %></h3>
                        <p><%= producto.descripcion %></p>

                        <p>
                            Precio:
                            <%= Number(producto.precio).toLocaleString(
                                "es-AR",
                                { style: "currency", currency: "ARS" }
                            ) %>
                        </p>

                        <p>
                            Estado:
                            <%= producto.activo ? "Activo" : "Inactivo" %>
                        </p>
                        <button
                            type="button"
                            class="cambiar-estado"
                            data-id="<%= producto.id %>"
                            data-activo="<%= producto.activo ? 'false' : 'true' %>"
                        >
                            <%= producto.activo ? "Desactivar" : "Reactivar" %>
                        </button>
                        <a href="/admin/productos/<%= producto.id %>/editar">Editar</a>
                    </article>
                <% } %>
            </section>
        <% } %>
    </main>

    <dialog id="confirmar-estado" aria-labelledby="titulo-confirmar-estado">
        <h2 id="titulo-confirmar-estado">Cambiar el estado del producto</h2>
        <p id="pregunta-estado"></p>

        <form method="dialog">
            <button type="submit" value="cancelar">Cancelar</button>
            <button type="submit" value="confirmar">Confirmar</button>
        </form>
    </dialog>

    <script src="/js/admin.js"></script>
</body>
</html>