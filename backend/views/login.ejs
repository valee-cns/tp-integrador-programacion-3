<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración | LV - Loot Valley</title>
    <link rel="stylesheet" href="/css/productos.css">
    <link rel="stylesheet" href="/css/tema.css">
    <script src="/js/tema.js"></script>
    <link rel="icon" href="/img/logo-loot-valley.png" type="image/png">
</head>
<body class="pagina-bienvenida pagina-login">
    <header class="cabecera-bienvenida">
        <div class="marca-bienvenida">
            <img src="/img/logo-loot-valley.png" alt="" width="80" height="80">
            <div class="texto-marca-bienvenida">
                <h1>LV - Loot Valley</h1>
                <p>Valentina Cisneros y Lian Giaccone — Programación III</p>
            </div>
        </div>

        <nav class="acciones-bienvenida">
            <a class="boton-enlace" href="/">Volver a bienvenida</a>
            <button type="button" id="cambiar-tema">Cambiar tema</button>
        </nav>
    </header>

    <main class="contenido-bienvenida">
        <section class="tarjeta-bienvenida tarjeta-login" aria-labelledby="titulo-login">
            <img class="logo-bienvenida" src="/img/logo-loot-valley.png"
                alt="" width="168" height="168">
            <h2 id="titulo-login">Iniciar sesión</h2>

            <p id="mensaje-login" role="alert"><%= error || "" %></p>

            <form id="formulario-login">
                <div class="campo-login">
                    <label class="etiqueta-bienvenida" for="correo">Correo:</label>
                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="Correo electrónico"
                        autocomplete="username"
                        maxlength="254"
                        required
                    >
                </div>

                <div class="campo-login">
                    <label class="etiqueta-bienvenida" for="password">Contraseña:</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Contraseña"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <button id="ingresar" type="submit">Ingresar</button>
                <button id="acceso-prueba" type="button">Acceso rápido</button>
            </form>
        </section>
    </main>

    <script src="/js/login.js"></script>
</body>
</html>