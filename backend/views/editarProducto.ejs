<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel administrativo | LV - Loot Valley</title>
    <link rel="stylesheet" href="/css/productos.css">
    <link rel="stylesheet" href="/css/tema.css">
    <script src="/js/tema.js"></script>
    <link rel="icon" href="/img/logo-loot-valley.png" type="image/png">
</head>
<body class="pagina-catalogo pagina-alta-producto pagina-editar-producto">
    <header class="cabecera-bienvenida">
        <div class="marca-bienvenida">
            <img src="/img/logo-loot-valley.png" alt="" width="80" height="80">
            <div class="texto-marca-bienvenida">
                <h1>LV - Loot Valley</h1>
                <p>Valentina Cisneros y Lian Giaccone — Programación III</p>
            </div>
        </div>

        <nav class="acciones-bienvenida">
            <a class="boton-enlace" href="/admin/dashboard">Volver al panel</a>
            <button type="button" id="cambiar-tema">Cambiar tema</button>
        </nav>
    </header>

    <main class="contenido-catalogo">
        <div class="encabezado-alta-producto">
            <span class="icono-alta-producto" aria-hidden="true"></span>
            <div>
                <h2>Editar producto</h2>
                <p>Modificá los datos del producto del catálogo.</p>
            </div>
        </div>

        <form class="formulario-alta-producto"
            action="/admin/productos/<%= producto.id %>/editar"
            method="post" enctype="multipart/form-data">

            <div class="fila-alta-producto fila-datos-producto">
                <div class="campo-alta-producto">
                    <label for="nombre">Nombre</label>
                    <input id="nombre" name="nombre" value="<%= producto.nombre %>" required>
                </div>

                <div class="campo-alta-producto">
                    <label for="categoriaId">Categoría</label>
                    <select id="categoriaId" name="categoriaId" required>
                        <% for (const categoria of categorias) { %>
                            <option value="<%= categoria.id %>"
                                <% if (categoria.id === producto.categoriaId) { %>selected<% } %>>
                                <%= categoria.nombre %>
                            </option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="campo-alta-producto">
                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" name="descripcion" rows="3"
                    required><%= producto.descripcion %></textarea>
            </div>

            <div class="campo-alta-producto campo-precio-edicion">
                <label for="precio">Precio</label>
                <input id="precio" name="precio" type="number" min="0.01" step="0.01"
                    value="<%= producto.precio %>" required>
            </div>

            <div class="campo-alta-producto imagen-actual-edicion">
                <strong>Imagen actual</strong>
                <% if (producto.imagen && producto.imagen !== "/img/producto-pendiente.png") { %>
                    <img src="<%= producto.imagen %>" alt="Imagen de <%= producto.nombre %>">
                <% } else { %>
                    <p>Sin imagen cargada.</p>
                <% } %>
            </div>

            <div class="campo-alta-producto campo-nueva-imagen">
                <label for="imagen">Nueva imagen (opcional)</label>
                <input id="imagen" name="imagen" type="file" accept="image/jpeg,image/png">
            </div>

            <div class="acciones-alta-producto">
                <button type="submit">Guardar producto</button>
            </div>
        </form>
    </main>
</body>
</html>